{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SP Gestionale",
  "version": "0.1.1",
  "identifier": "it.sp.gestionale",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "accesso",
        "title": "SP Gestionale",
        "width": 400,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      },
      {
        "label": "principale",
        "title": "SP Gestionale",
        "visible": false,
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm", "appimage", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "Gestione abbonamenti palestra",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyQzhEMTg3Mjk4MDNCQUIKUldTck80QXBoOUhJMGxMU3VSdlEzZklTZ3RIRVhPNE1DdnBsdFpubWxSYWIwNjlNa3FEUVJXWHQK",
      "endpoints": ["https://github.com/xydani/sp-gestionale/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
